  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "allardhoeve",
      "url": "https://github.com/allardhoeve"
    }
  ],
  "esmodules": [
    "src/hexmap.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/allardhoeve/foundry-cli",
  "manifest": "https://raw.githubusercontent.com/allardhoeve/foundry-cli/main/module/module.json",
  "download": "https://github.com/allardhoeve/foundry-cli/releases/download/module-v0.2.4/module.zip"
}
